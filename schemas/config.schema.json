{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpipeline.local/schemas/config.schema.json",
  "title": "Resolved framework configuration (defaults + profile + project overrides)",
  "type": "object",
  "required": [
    "profile",
    "max_parallel_agents",
    "max_agent_calls",
    "max_operator_calls",
    "max_repair_iterations",
    "max_task_retries",
    "max_no_progress_iterations",
    "model_routing",
    "gates"
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "enum": [
        "fast",
        "balanced",
        "strict"
      ]
    },
    "description": {
      "type": "string"
    },
    "max_parallel_agents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "max_agent_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900
    },
    "max_operator_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900
    },
    "max_repair_iterations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "max_task_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "max_no_progress_iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "max_output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1000
    },
    "max_runtime_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "require_plan_approval": {
      "type": "boolean"
    },
    "auto_accept_assumptions": {
      "type": "boolean"
    },
    "block_on_preexisting_failures": {
      "type": "boolean"
    },
    "check_timeout_seconds": {
      "type": "integer",
      "minimum": 10
    },
    "model_routing": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "opus",
          "sonnet",
          "haiku",
          "fable",
          "inherit"
        ]
      }
    },
    "effort_routing": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "mandatory",
          "optional",
          "disabled"
        ]
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "auto",
          "required",
          "disabled"
        ]
      }
    },
    "live_ai_evaluation": {
      "enum": [
        "mandatory",
        "optional",
        "disabled"
      ]
    },
    "viewports": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]+x[0-9]+$"
      }
    }
  }
}
