{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devpipeline.local/schemas/task.schema.json",
  "title": "Task dependency graph",
  "type": "object",
  "required": [
    "tasks"
  ],
  "additionalProperties": false,
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "id",
        "agent",
        "title",
        "requirements",
        "dependencies",
        "owned_paths",
        "acceptance_criteria",
        "status",
        "attempt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TASK-[0-9]{3,}(-R[0-9]+)?$"
        },
        "agent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "design",
            "contract",
            "implementation",
            "repair",
            "documentation",
            "test"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TASK-[0-9]{3,}(-R[0-9]+)?$"
          },
          "uniqueItems": true
        },
        "owned_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shared_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^AC-[0-9]{3,}$"
          }
        },
        "validation_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "PENDING",
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "BLOCKED",
            "SKIPPED",
            "CANCELLED"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "issue_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ISSUE-[0-9]{3,}$"
          }
        },
        "repair_iteration": {
          "type": "integer",
          "minimum": 0
        },
        "base_revision": {
          "type": "string"
        },
        "result_revision": {
          "type": "string"
        },
        "worktree": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "failure_reason": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "run_id": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  }
}
