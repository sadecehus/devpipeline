{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp_npx.mjs",
        "@playwright/mcp@0.0.86",
        "--headless",
        "--isolated",
        "--output-dir",
        "${CLAUDE_PLUGIN_DATA}/playwright-output"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
